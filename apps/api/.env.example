# Copy to .env and adjust. Every key is prefixed OPEN_SESSION_.

# --- Core ---------------------------------------------------------------
OPEN_SESSION_ENVIRONMENT=development
OPEN_SESSION_DATABASE_URL=sqlite:///./open_session.db
# Change before deploying — this signs session cookies.
OPEN_SESSION_SESSION_SECRET=dev-only-change-me-please
# Evaluation deployment only. Enables one-click access to pre-seeded personas.
# Never enable this for a normal production deployment.
OPEN_SESSION_EVALUATION_MODE=false
OPEN_SESSION_EVALUATION_ORGANIZER_EMAIL=sbek-organizer@example.com
OPEN_SESSION_EVALUATION_SPEAKER_EMAIL=sbek-speaker@example.com
OPEN_SESSION_EVALUATION_REVIEWER_EMAIL=sbek-reviewer@example.com
OPEN_SESSION_EVALUATION_EVENT_SLUG=devflow-conf-2027

# Real AI-assisted abstract review (optional at runtime).
OPEN_SESSION_AI_REVIEW_ENABLED=false
OPEN_SESSION_OPENAI_API_KEY=
OPEN_SESSION_AI_REVIEW_MODEL=gpt-5.6-luna
OPEN_SESSION_AI_REVIEW_TIMEOUT_SECONDS=45
OPEN_SESSION_AI_REVIEW_MAX_RUNS_PER_SUBMISSION=5

# Speaker calendar connections. Register these exact callback URLs with each
# provider: {API_PUBLIC_URL}/api/v1/calendar/oauth/{google|microsoft}/callback
OPEN_SESSION_WEB_APP_URL=http://localhost:5173
OPEN_SESSION_API_PUBLIC_URL=http://localhost:8000
OPEN_SESSION_GOOGLE_CALENDAR_CLIENT_ID=
OPEN_SESSION_GOOGLE_CALENDAR_CLIENT_SECRET=
OPEN_SESSION_MICROSOFT_CALENDAR_CLIENT_ID=
OPEN_SESSION_MICROSOFT_CALENDAR_CLIENT_SECRET=
OPEN_SESSION_MICROSOFT_CALENDAR_TENANT=common

# --- Email --------------------------------------------------------------
# Off by default: sign-in codes and notifications are written to the server log
# instead of being delivered, which is what makes local development possible
# without a provider. Turn it on to send for real.
OPEN_SESSION_EMAIL_ENABLED=false

# "cloudflare" (Cloudflare Email Service REST API) or "smtp".
OPEN_SESSION_EMAIL_PROVIDER=cloudflare

# --- Cloudflare Email Service -------------------------------------------
# Setup, once per account:
#   1. Add the sending domain under Email > Email Service > Email Sending and
#      complete the DNS records Cloudflare gives you (SPF/DKIM/DMARC).
#   2. Create an API token with the "Email Sending: Edit" permission.
#   3. Copy your account id from the Cloudflare dashboard URL or the sidebar.
# Sending to arbitrary recipients needs the Workers Paid plan; sending to
# verified destination addresses on your own account is free on any plan.
# OPEN_SESSION_CLOUDFLARE_API_TOKEN=cf_xxxxxxxxxxxx
# OPEN_SESSION_CLOUDFLARE_ACCOUNT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- SMTP ---------------------------------------------------------------
# Cloudflare also accepts authenticated SMTP, which is what the settings below
# describe. Note port 465 with implicit TLS (USE_SSL) — Cloudflare rejects
# STARTTLS on 587 — and the username is the literal string "api_token" with
# your API token as the password.
#   OPEN_SESSION_SMTP_HOST=smtp.mx.cloudflare.net
#   OPEN_SESSION_SMTP_PORT=465
#   OPEN_SESSION_SMTP_USE_SSL=true
#   OPEN_SESSION_SMTP_USERNAME=api_token
#   OPEN_SESSION_SMTP_PASSWORD=cf_xxxxxxxxxxxx
#
# Defaults below target Mailpit/MailHog for local inspection (no auth, no TLS).
OPEN_SESSION_SMTP_HOST=localhost
OPEN_SESSION_SMTP_PORT=1025
OPEN_SESSION_SMTP_USE_TLS=false
OPEN_SESSION_SMTP_USE_SSL=false
# OPEN_SESSION_SMTP_USERNAME=
# OPEN_SESSION_SMTP_PASSWORD=

# The From: on every outbound email. The domain must be onboarded for Email
# Sending on the Cloudflare account that owns the token above.
OPEN_SESSION_EMAIL_SENDER_NAME=Open Session
OPEN_SESSION_EMAIL_SENDER_ADDRESS=noreply@localhost

# --- Rate limiting ------------------------------------------------------
# Throttles magic-code requests and public CFP submissions. Seeding a demo signs
# in several times from one IP, so turn this off if the first login after
# seeding gets rejected.
OPEN_SESSION_RATE_LIMIT_ENABLED=true

# --- Files --------------------------------------------------------------
OPEN_SESSION_FILES_STORAGE_DIR=./data/files
