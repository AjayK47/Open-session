# Source this file before running ./deploy/cloudflare/deploy.sh.
# Never commit populated secrets.

CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

OPEN_SESSION_D1_DATABASE_NAME=open-session
OPEN_SESSION_D1_DATABASE_ID=
OPEN_SESSION_R2_BUCKET_NAME=open-session-files
OPEN_SESSION_PUBLIC_URL=https://sessions.example.com

# Generate with: openssl rand -hex 32
OPEN_SESSION_SESSION_SECRET=

OPEN_SESSION_EMAIL_ENABLED=true
OPEN_SESSION_EMAIL_SENDER_ADDRESS=hello@sessions.example.com
# Optional separate token with Email Sending: Edit. If omitted, the deployment
# token above is also installed as the email API token.
OPEN_SESSION_EMAIL_API_TOKEN=

OPEN_SESSION_AI_REVIEW_ENABLED=false
OPEN_SESSION_OPENAI_API_KEY=
OPEN_SESSION_AI_REVIEW_MODEL=gpt-5.6-luna

# Optional. Without this, speakers still receive/download provider-independent
# .ics calendar invites.
OPEN_SESSION_COMPOSIO_API_KEY=
